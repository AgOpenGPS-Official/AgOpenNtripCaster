# ============================================================================
# NtripCaster Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values before deployment
# ============================================================================

# ============================================================================
# Application Settings
# ============================================================================
ASPNETCORE_ENVIRONMENT=Production
APP_NAME=NtripCaster
APP_VERSION=1.0.0

# ============================================================================
# Database Configuration
# ============================================================================
# PostgreSQL connection details
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ntripcaster
DB_USER=ntripcaster
DB_PASSWORD=change_this_to_a_strong_password_min_16_chars
# Connection string is auto-generated from above values

# ============================================================================
# Email Configuration (SMTP)
# ============================================================================
# These are initial defaults - can be changed via admin UI after deployment
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-not-your-regular-password
SMTP_FROM_EMAIL=noreply@ntripcaster.local
SMTP_FROM_NAME=NtripCaster
SMTP_ENABLE_TLS=true
SMTP_ENABLE_SSL=false

# ============================================================================
# Security Settings
# ============================================================================
# JWT Secret for token signing (generate with: openssl rand -base64 32)
JWT_SECRET_KEY=change_this_to_a_secure_random_string_min_32_chars
JWT_EXPIRATION_MINUTES=1440

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# ============================================================================
# API Configuration
# ============================================================================
API_PORT=5000
API_HOST=0.0.0.0

# ============================================================================
# Frontend Configuration
# ============================================================================
FRONTEND_PORT=80
FRONTEND_HOST=0.0.0.0

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=Information
# Possible values: Debug, Information, Warning, Error, Critical
ENABLE_FILE_LOGGING=true
LOG_FILE_PATH=/app/logs/app.log
MAX_LOG_FILE_SIZE_MB=100
LOG_RETENTION_DAYS=30

# ============================================================================
# NTRIP Server Configuration
# ============================================================================
# Port for NTRIP client connections
NTRIP_SERVER_PORT=2101
NTRIP_SERVER_HOST=0.0.0.0

# ============================================================================
# Docker Configuration
# ============================================================================
# Docker registry (leave empty for Docker Hub, or set to your registry)
DOCKER_REGISTRY=
DOCKER_IMAGE_TAG=latest

# ============================================================================
# Admin User Initial Credentials
# ============================================================================
# These will be used to create the initial admin account on first deployment
# IMPORTANT: Change these before deployment!
INITIAL_ADMIN_EMAIL=admin@ntripcaster.local
INITIAL_ADMIN_PASSWORD=change_this_on_first_login

# ============================================================================
# Optional: External Integrations
# ============================================================================
# Add additional configuration for external services as needed
# Example:
# EXTERNAL_SERVICE_API_KEY=your-api-key
# EXTERNAL_SERVICE_URL=https://api.example.com
