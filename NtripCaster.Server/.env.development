# Environment: Development
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://0.0.0.0:5000

# Database
CONNECTION_STRING=Host=localhost;Port=5432;Database=ntripcaster;Username=ntripuser;Password=ntrippass123

# JWT
JWT_SECRET=your-super-secret-key-that-is-at-least-32-characters-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-chars

# CORS
CORS_ORIGIN=http://localhost:3000

# Email (Disable for development, or configure SMTP)
# Set to true to enable email verification
Email__VerificationRequired=false
# SMTP Configuration (optional for development)
Email__Smtp__Host=localhost
Email__Smtp__Port=587
Email__Smtp__Username=
Email__Smtp__Password=
Email__Smtp__FromEmail=noreply@ntripcaster.local
Email__Smtp__FromName=NtripCaster

# Logging
Logging__LogLevel__Default=Debug
Logging__LogLevel__Microsoft=Warning
