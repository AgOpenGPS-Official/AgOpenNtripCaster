# ============================================================
# AgOpen Ntripcaster Environment Configuration
# Template for .env file
#
# Copy this file to .env and fill in your values
# OR run setup.sh (Linux/Mac) or setup.ps1 (Windows)
# ============================================================

# ============================================================
# SERVER CONFIGURATION
# ============================================================
SERVER_DOMAIN=ntripcaster.example.com
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
NTRIP_PORT=2101
ASPNETCORE_URLS=http://0.0.0.0:5000
ASPNETCORE_ENVIRONMENT=Production
WEB_PORT=8080
WEB_PORT_SSL=4433

# ============================================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================================
DB_CONNECTION_STRING=Server=postgres;Port=5432;Database=ntripcaster_db;User Id=ntripcaster;Password=your_secure_password;
DB_HOST=postgres
DB_PORT=5432
DB_PORT_EXTERNAL=5432
DB_NAME=ntripcaster_db
DB_USER=ntripcaster
DB_PASSWORD=your_secure_password

# ============================================================
# JWT AUTHENTICATION
# ============================================================
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=30
CORS_ORIGINS=https://ntripcaster.example.com,http://localhost:3000

# ============================================================
# INITIAL ADMIN CREDENTIALS
# ============================================================
ADMIN_EMAIL=admin@ntripcaster.example.com
ADMIN_PASSWORD=change_me_on_first_login

# ============================================================
# EMAIL CONFIGURATION (SMTP)
# ============================================================
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=AgOpen Ntripcaster
SMTP_ENABLE_TLS=true
SMTP_ENABLE_SSL=false

# ============================================================
# SSL/TLS CONFIGURATION
# ============================================================
SSL_METHOD=letsencrypt
SSL_CERT_PATH=/etc/letsencrypt/live/ntripcaster.example.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/ntripcaster.example.com/privkey.pem
LE_EMAIL=admin@example.com

# ============================================================
# DOCKER CONFIGURATION
# ============================================================
DOCKER_REGISTRY=
IMAGE_TAG=latest
RESTART_POLICY=unless-stopped

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=Information

# ============================================================
# BACKUP CONFIGURATION
# ============================================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/backups

# ============================================================
# SECURITY
# ============================================================
ALLOW_REGISTRATION=true
SOURCE_PASSWORD_SALT=your_random_salt_here

# ============================================================
# ADVANCED CONFIGURATION
# ============================================================
MAX_CONNECTIONS_PER_USER=10
MAX_ACTIVE_SOURCES=50
ACTIVITY_LOG_RETENTION_DAYS=90
STATS_BROADCAST_INTERVAL=10
CLIENT_POSITION_TIMEOUT=30
BACKUP_SCHEDULE=0 2 * * *
