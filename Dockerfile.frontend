# AgOpen Ntripcaster Frontend - React + Vite Build
# This Dockerfile only builds the frontend application
# Static files are served by a separate NGINX container

FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY AgOpenNtripCaster.Client/package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source code
COPY AgOpenNtripCaster.Client ./

# Build the application
RUN npm run build

# The dist folder will be copied to a volume by docker-compose
# and served by the separate nginx container
