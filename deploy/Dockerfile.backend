# AgOpen Ntripcaster Backend - ASP.NET 9 Core
# The final image is SDK-based so `dotnet ef database update` works inside the running container.
FROM mcr.microsoft.com/dotnet/sdk:9.0

# dotnet-ef global tool
RUN dotnet tool install --global dotnet-ef --version "9.*"
ENV PATH="${PATH}:/root/.dotnet/tools"
ENV DOTNET_NOLOGO=1
ENV DOTNET_CLI_TELEMETRY_OPTOUT=1

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Project source lives in /app so `dotnet ef` finds the project from the default working directory
WORKDIR /app
COPY AgOpenNtripCaster.Server/ .
RUN dotnet restore

# Publish the application into /app (alongside the project, so ef and the app share one directory)
RUN dotnet publish -c Release -o /app --no-restore

# Create logs directory
RUN mkdir -p /app/logs && chmod 777 /app/logs

# Set environment
ENV ASPNETCORE_URLS=http://+:5000
ENV ASPNETCORE_ENVIRONMENT=Production

EXPOSE 5000 2101

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5000/api/health || exit 1

# Run the application
ENTRYPOINT ["dotnet", "AgOpenNtripCaster.Server.dll"]
