# AgOpen Ntripcaster Frontend - React + Vite Build
# This Dockerfile only builds the frontend application
# Static files are served by a separate NGINX container

FROM node:20-alpine AS build

WORKDIR /app

# Copy package files
COPY AgOpenNtripCaster.Client/package*.json ./

# Install dependencies
RUN npm install --legacy-peer-deps

# Copy source code
COPY AgOpenNtripCaster.Client ./

# Build the application
RUN npm run build

# Runtime stage - just to copy files to shared volume
FROM alpine:latest

WORKDIR /output

# Copy built files from build stage
COPY --from=build /app/dist /app/dist

# Create entrypoint script to copy files to volume
RUN echo '#!/bin/sh' > /entrypoint.sh && \
    echo 'echo "Copying frontend build to shared volume..."' >> /entrypoint.sh && \
    echo 'rm -rf /output/*' >> /entrypoint.sh && \
    echo 'cp -r /app/dist/* /output/' >> /entrypoint.sh && \
    echo 'echo "Frontend files copied successfully!"' >> /entrypoint.sh && \
    echo 'ls -la /output/' >> /entrypoint.sh && \
    chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
